# Copy to infra/.env. Generate secrets yourself. Never commit a real .env.
POSTGRES_DB=shutong
POSTGRES_USER=shutong
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32PLUS_CHARACTERS
# 双凭据隔离（P0-1）：管理端与学生端令牌绝对不能相同
SHUTONG_ADMIN_TOKEN=REPLACE_WITH_RANDOM_32PLUS_CHARACTERS_ADMIN
SHUTONG_STUDENT_TOKEN=REPLACE_WITH_RANDOM_32PLUS_CHARACTERS_STUDENT
# AI 错题引导服务（DeepSeek / OpenAI 兼容接口）
SHUTONG_AI_BASE_URL=https://api.deepseek.com
SHUTONG_AI_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
SHUTONG_AI_MODEL=deepseek-chat
SHUTONG_AI_TIMEOUT_SECONDS=25
CORS_ORIGINS=http://localhost:5173
# Restic: set only on backup host; NEVER put backup password in Git.
# RESTIC_REPOSITORY=s3:https://your-independent-backup-provider/bucket
# RESTIC_PASSWORD_FILE=/absolute/private/path/to/restic-password
# AC-OPS-02 alerting hook (optional): on every successful backup+check+forget a single push is sent;
# Uptime Kuma raises the alarm when silence exceeds its timeout.
# KUMA_PUSH_URL=https://kuma.example.com/api/push/XXXXXXXX
# AC-OPS-02 alerting (optional): healthchecks.io dead-man switch.
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<your-uuid>
# 环境隔离/迁移参数（生产根目录位于 /media/xc/backup_ext4/pageboy-home/production，见 docs/operations/prod-separation-runbook.md）：
# PAGEBOY_HOME=/media/xc/backup_ext4/pageboy-home
# SHUTONG_UID=1001                       # api 容器运行 uid（须等于 production/data/attachments 目录属主 shutong-prod）
# SHUTONG_GID=1001
# SHUTONG_ATTACHMENTS_DIR=/media/xc/backup_ext4/pageboy-home/production/data/attachments   # 附件宿主目录（备份脚本用 ATTACHMENTS_DIR 指向同一处）
# SHUTONG_STANDARDS_DIR=/media/xc/backup_ext4/pageboy-home/production/data/curriculum_standards   # 官方课标 PDF 原件目录
