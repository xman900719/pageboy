# Copy to infra/.env. Generate secrets yourself. Never commit a real .env.
POSTGRES_DB=shutong
POSTGRES_USER=shutong
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32PLUS_CHARACTERS
SHUTONG_TOKEN=REPLACE_WITH_RANDOM_32PLUS_CHARACTERS
CORS_ORIGINS=http://localhost:5173
# Restic: set only on backup host; NEVER put backup password in Git.
# RESTIC_REPOSITORY=s3:https://your-independent-backup-provider/bucket
# RESTIC_PASSWORD_FILE=/absolute/private/path/to/restic-password
