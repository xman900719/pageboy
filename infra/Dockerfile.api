FROM python:3.12-slim
WORKDIR /app
COPY services/api/pyproject.toml /app/pyproject.toml
COPY services/api/shutong /app/shutong
COPY services/api/alembic /app/alembic
COPY services/api/alembic.ini /app/alembic.ini
RUN pip install --no-cache-dir .
RUN useradd -r -u 10001 shutong
USER shutong
CMD ["uvicorn", "shutong.main:app", "--host", "0.0.0.0", "--port", "8000"]
