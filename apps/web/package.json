{
  "name": "shutong-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run --dir src",
    "test:e2e": "playwright test",
    "test:e2e:ipad": "E2E_DEVICE=ipad playwright test"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
