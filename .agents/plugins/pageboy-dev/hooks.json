{
  "pageboy-safety-and-gates": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/session_start_check.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/pre_command_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
